{
  "$id": "error.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Format error (Spec API Backend 1.2)",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "details"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}
