{
  "$id": "members-list.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /x207/circles/{circle}/members",
  "type": "object",
  "required": ["circle", "unit", "decimals", "items", "nextCursor"],
  "additionalProperties": false,
  "properties": {
    "circle": { "type": "string" },
    "unit": { "$ref": "common.json#/definitions/unit" },
    "decimals": { "$ref": "common.json#/definitions/decimals" },
    "items": { "type": "array", "items": { "$ref": "member.json#/definitions/item" } },
    "nextCursor": { "$ref": "common.json#/definitions/nextCursor" }
  }
}
