# Copy to .env and fill in. Secrets live only in .env; this file has no values.

# 1Click partner JWT (optional for the MVP; without a JWT the quote is charged +25 bps)
ONECLICK_JWT=
ONECLICK_BASE_URL=

# NEAR RPC for the indexer: FastNEAR as primary, the official RPC as fallback (required, no default value in code)
NEAR_RPC_PRIMARY_URL=
NEAR_RPC_FALLBACK_URL=

# Read API: requests per minute per IP (0 or empty = no limit)
API_RATE_LIMIT_PER_MINUTE=
# Abuse limits (BE-066); empty = defaults listed in the README: API_WRITE_RATE_PER_MINUTE_IP (120), API_WRITE_RATE_PER_MINUTE_ACCOUNT (60), API_MAX_BODY_BYTES (65536),
# API_MAX_PAGE_LIMIT (200), API_TRUST_PROXY (1 only behind your own proxy), API_MAX_OPEN_ORDERS / API_MAX_OPEN_INVOICES / API_MAX_OPEN_PURCHASES (50)
# API_LIMITS=off disables all rate limits and open-object limits at once (for e2e tests); body and page limits stay. Per process: two instances count separately.

# Settlement worker: mock | dry (default) | live. dry:false is accepted only in live.
X207_SETTLEMENT_MODE=
# 1Click app fee (optional): JSON [{"recipient":"<Intents account>","fee":<bps>}]; empty = no app fee
X207_APP_FEES=

# Main process (npm run build, then npm start)
X207_CONTRACT_ID=
X207_START_BLOCK=
# Optional: X207_CIRCLE_ID (agents-main), X207_DB_PATH (x207.sqlite), X207_API_HOST (127.0.0.1), X207_API_PORT (8080), X207_JOB_POLL_MS (15000)
# D10 registry of DAOs that rent out votes (BE-061): JSON file {"<DAO account>": {"rentable_vote_kinds": [{"kind": "gauge_weight", "contract": "<contract that handles only that kind>"}]}}, filled in by circle governance; empty = no DAO rents out votes
X207_DAO_REGISTRY_PATH=
# Operator secret key for code_seen (BE-069): HMAC-SHA256 of the issuer and every code that was checked, used to reject the same code on a second listing (code_duplicate). Empty = feature off (a warning is logged). Do not change it casually: old HMACs no longer match.
X207_CODE_SEEN_KEY=
# Demo only (B7-C10): register the in-memory mock code issuer under this name, with these codes valid (comma separated). Empty = no issuer registered
X207_CODE_MOCK_ISSUER=
# Transfers through a platform (BE-074): DNS over HTTPS, RDAP of the registry, Steam Web API key (empty key = game item transfers are off)
X207_DOH_URL=
X207_RDAP_BASE_URL=
X207_STEAM_API_KEY=
X207_CODE_MOCK_CODES=

# Metrics (BE-071): when set, GET /metrics requires Authorization: Bearer <token>; /healthz stays open. Logs: one JSON object per line on stderr, with secrets redacted.
METRICS_TOKEN=
# A-BE-10/BE-108: without METRICS_TOKEN /metrics is closed (401); X207_METRICS_OPEN=1 opens it without a token
X207_METRICS_OPEN=

# Public read API (BE-089): GET routes only, no settlement endpoints; CORS only for the listed origins (comma separated, exact, no wildcard)
# A-BE-02/BE-104: read-only is the DEFAULT. Set 0 (or false) to turn on the write and settlement routes; any other value, empty or unset stays read-only.
X207_READ_ONLY=1
X207_CORS_ORIGINS=
# BE-089: block source of the indexer: rpc (default) | neardata | account-index (testnet: only the blocks of the transactions of the account, from the index of FastNEAR)
X207_BLOCK_SOURCE=
X207_NEARDATA_URL=
X207_TX_INDEX_URL=
X207_NEARDATA_MIN_INTERVAL_MS=
