# Salin ke .env lalu isi. Rahasia hanya di .env; file ini tanpa nilai.

# 1Click partner JWT (opsional untuk MVP; tanpa JWT quote kena +25 bps)
ONECLICK_JWT=
ONECLICK_BASE_URL=

# RPC NEAR indexer: FastNEAR sebagai utama, RPC resmi sebagai cadangan (wajib, tanpa nilai bawaan di kode)
NEAR_RPC_PRIMARY_URL=
NEAR_RPC_FALLBACK_URL=

# Read API: batas permintaan per menit per IP (0 atau kosong = tanpa batas)
API_RATE_LIMIT_PER_MINUTE=
# Batas penyalahgunaan (BE-066), kosong = bawaan di README: API_WRITE_RATE_PER_MINUTE_IP (120), API_WRITE_RATE_PER_MINUTE_ACCOUNT (60), API_MAX_BODY_BYTES (65536),
# API_MAX_PAGE_LIMIT (200), API_TRUST_PROXY (1 hanya di belakang proxy sendiri), API_MAX_OPEN_ORDERS / API_MAX_OPEN_INVOICES / API_MAX_OPEN_PURCHASES (50)
# API_LIMITS=off mematikan semua rate limit dan batas objek terbuka sekaligus (untuk test e2e); batas body dan halaman tetap. Per proses: dua instance menghitung sendiri-sendiri.

# Settlement worker: mock | dry (default) | live. dry:false hanya diterima di live.
X207_SETTLEMENT_MODE=
# App fee 1Click (opsional): JSON [{"recipient":"<akun Intents>","fee":<bps>}]; kosong = tanpa app fee
X207_APP_FEES=

# Proses utama (npm run build lalu npm start)
X207_CONTRACT_ID=
X207_START_BLOCK=
# Opsional: X207_CIRCLE_ID (agents-main), X207_DB_PATH (x207.sqlite), X207_API_HOST (127.0.0.1), X207_API_PORT (8080), X207_JOB_POLL_MS (15000)
# Registri D10 DAO yang menyewakan suara (BE-061): berkas JSON {"<akun DAO>": {"rentable_vote_kinds": [{"kind": "gauge_weight", "contract": "<kontrak yang hanya mengurus jenis itu>"}]}}, diisi tata kelola circle; kosong = tidak ada DAO yang menyewakan suara
X207_DAO_REGISTRY_PATH=
# Kunci rahasia operator untuk code_seen (BE-069): HMAC-SHA256 dari penerbit dan kode yang pernah dicek, untuk menolak kode yang sama di listing kedua (code_duplicate). Kosong = fitur mati (ada peringatan di log). Jangan ganti sembarangan: HMAC lama tidak cocok lagi.
X207_CODE_SEEN_KEY=
# Demo only (B7-C10): register the in-memory mock code issuer under this name, with these codes valid (comma separated). Empty = no issuer registered
X207_CODE_MOCK_ISSUER=
X207_CODE_MOCK_CODES=

# Metrik (BE-071): bila diisi, GET /metrics butuh Authorization: Bearer <token>; /healthz tetap terbuka. Log: JSON per baris di stderr dengan redaksi rahasia.
METRICS_TOKEN=
