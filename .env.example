# Salin ke .env lalu isi. Rahasia hanya di .env; file ini tanpa nilai.

# 1Click partner JWT (opsional untuk MVP; tanpa JWT quote kena +25 bps)
ONECLICK_JWT=
ONECLICK_BASE_URL=

# RPC NEAR indexer: FastNEAR sebagai utama, RPC resmi sebagai cadangan (wajib, tanpa nilai bawaan di kode)
NEAR_RPC_PRIMARY_URL=
NEAR_RPC_FALLBACK_URL=

# Read API: batas permintaan per menit per IP (0 atau kosong = tanpa batas)
API_RATE_LIMIT_PER_MINUTE=

# Settlement worker: mock | dry (default) | live. dry:false hanya diterima di live.
X207_SETTLEMENT_MODE=
# App fee 1Click (opsional): JSON [{"recipient":"<akun Intents>","fee":<bps>}]; kosong = tanpa app fee
X207_APP_FEES=

# Proses utama (npm run build lalu npm start)
X207_CONTRACT_ID=
X207_START_BLOCK=
# Opsional: X207_CIRCLE_ID (agents-main), X207_DB_PATH (x207.sqlite), X207_API_HOST (127.0.0.1), X207_API_PORT (8080), X207_JOB_POLL_MS (15000)
# Registri D10 DAO yang menyewakan suara (BE-061): berkas JSON {"<akun DAO>": {"rentable_vote_kinds": [{"kind": "gauge_weight", "contract": "<kontrak yang hanya mengurus jenis itu>"}]}}, diisi tata kelola circle; kosong = tidak ada DAO yang menyewakan suara
X207_DAO_REGISTRY_PATH=
