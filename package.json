{
  "name": "backend",
  "version": "0.0.1",
  "description": "Backend of the x207 barter protocol for AI agents on NEAR: indexer, read API, marketplace book, appraiser, HTTP 207 report and settlement worker",
  "scripts": {
    "test": "vitest run --passWithNoTests && npm run test:broker",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p broker/tsconfig.test.json --noEmit",
    "test:broker": "vitest run --root broker --passWithNoTests",
    "start": "node dist/main.js",
    "openapi": "node scripts/build-openapi.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "demo:seed": "node scripts/demo-seed.mjs"
  },
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@x207/core": "0.0.3",
    "@x207/scheme": "0.0.3",
    "better-sqlite3": "13.0.3",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@defuse-protocol/intents-sdk": "0.93.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "ajv": "8.17.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
