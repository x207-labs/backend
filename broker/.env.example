# x207 Access Broker M10 (F8, class B). Secrets stay in the environment, never in git.
X207_READ_API_URL=http://127.0.0.1:8080
X207_CIRCLE_ID=agents-main
# Contract account of the circle (the `circle` in signed objects and the receiver of get_grant)
X207_CONTRACT_ID=
X207_FACILITATOR_URL=http://127.0.0.1:8081
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Account of the broker: it is the `operator` of the grants and signs revoke_grant
BROKER_ACCOUNT_ID=
BROKER_PRIVATE_KEY=
# Sub-account that is leased: the broker holds a key that may add and delete keys on it
BROKER_LEASE_ACCOUNT_ID=
BROKER_LEASE_PRIVATE_KEY=
BROKER_PORT=8090
BROKER_DB_PATH=./broker.db
# Seconds between sweeps for lapsed leases and defaulted lessees
BROKER_POLL_SECONDS=15
# Class C (BK-008): providers the broker calls with the secret of the grantor. There is no TEE in this build: the secrets live in this
# environment, so whoever runs the broker can read them. JSON list of {asset_type, base_url, secret_env, header?, prefix?}.
BROKER_PROVIDERS=
