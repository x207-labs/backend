# x207 Access Broker M10 (F8, class B). Secrets stay in the environment, never in git.
X207_READ_API_URL=http://127.0.0.1:8080
X207_CIRCLE_ID=agents-main
# Contract account of the circle (the `circle` in signed objects and the receiver of get_grant)
X207_CONTRACT_ID=
X207_FACILITATOR_URL=http://127.0.0.1:8081
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Account of the broker: it is the `operator` of the grants and signs revoke_grant
BROKER_ACCOUNT_ID=
BROKER_PRIVATE_KEY=
# Sub-account that is leased: the broker holds a key that may add and delete keys on it
BROKER_LEASE_ACCOUNT_ID=
BROKER_LEASE_PRIVATE_KEY=
BROKER_PORT=8090
BROKER_DB_PATH=./broker.db
# Seconds between sweeps for lapsed leases and defaulted lessees
BROKER_POLL_SECONDS=15
# Class C (BK-008): providers the broker calls with the secret of the grantor. There is no TEE in this build: the secrets live in this
# environment, so whoever runs the broker can read them. JSON list of {asset_type, base_url, secret_env, header?, prefix?}.
BROKER_PROVIDERS=
# Optional dotenv file with the provider secrets; kill -HUP the broker after changing it to rotate (no grant is cut).
BROKER_SECRETS_FILE=
# Audit log of the class C calls and secret rotations (JSON lines, no secrets, not encrypted: there is no enclave key in this build).
BROKER_AUDIT_PATH=

# P2 (BE-057): self-hosted (default) = the grantor runs this broker and the admin tokens of the providers stay on this machine; hosted = demo with mock providers only.
BROKER_MODE=self-hosted

# Tests with the real accounts of the owner (BE-059): put these in the .env at the ROOT of the project, not here. Each real test needs EVERY variable it lists, otherwise it is skipped.
# Access goes only to the grantee named here and is always taken back at the end of the test. The values are never printed.
#   GITHUB_TEST_TOKEN  GITHUB_TEST_ORG  GITHUB_TEST_REPO  GITHUB_TEST_GRANTEE
#   DISCORD_TEST_BOT_TOKEN  DISCORD_TEST_GUILD_ID  DISCORD_TEST_ROLE_ID  DISCORD_TEST_GRANTEE_ID
